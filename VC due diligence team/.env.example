# ---- Choose the brain: gemini | claude -------------------------------------
LLM_PROVIDER=gemini

# ---- Gemini (Google AI Studio key: https://aistudio.google.com/apikey) ------
GOOGLE_API_KEY=your-gemini-api-key
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# ---- Claude (Anthropic key: https://platform.claude.com) --------------------
ANTHROPIC_API_KEY=your-anthropic-api-key

# ---- Optional overrides ------------------------------------------------------
# FAST_MODEL=gemini-3.5-flash          # or claude-sonnet-5-5
# DEEP_MODEL=gemini-3.1-pro-preview    # or claude-opus-5-5
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# SEARCH_BACKEND=auto                  # auto | google | tavily | duckduckgo
# TAVILY_API_KEY=your-tavily-key       # better search quality in Claude mode
# IMAGE_PROVIDER=auto                  # auto | gemini | local
# OUTPUT_DIR=./outputs
